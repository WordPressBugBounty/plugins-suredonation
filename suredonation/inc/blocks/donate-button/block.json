{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suredonation/donate-button",
	"title": "Donate Button",
	"description": "Displays a donate/submit button for the donation form",
	"category": "suredonation",
	"keywords": [
		"donate",
		"button",
		"submit",
		"donation"
	],
	"textdomain": "suredonation",
	"supports": {
		"reusable": false,
		"html": false,
		"multiple": false
	},
	"example": {
		"attributes": {
			"preview": true
		}
	},
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"block_id": {
			"type": "string"
		},
		"fieldWidth": {
			"type": "number",
			"default": 100
		},
		"buttonText": {
			"type": "string",
			"default": "Donate"
		},
		"formId": {
			"type": "number",
			"default": 0
		},
		"slug": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"customClasses": {
			"type": "string",
			"default": ""
		}
	}
}
