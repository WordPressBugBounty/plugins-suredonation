{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suredonation/campaign-donations",
	"title": "Campaign Donations",
	"description": "Displays a list of recent donations for the campaign.",
	"category": "suredonation-campaign",
	"keywords": [ "campaign", "donations", "recent", "list" ],
	"textdomain": "suredonation",
	"supports": {
		"html": false,
		"reusable": false
	},
	"example": {
		"attributes": {
			"preview": true
		}
	},
	"attributes": {
		"campaignId": {
			"type": "number",
			"default": 0
		},
		"donationsToShow": {
			"type": "number",
			"default": 5
		},
		"showAnonymous": {
			"type": "boolean",
			"default": true
		},
		"showButton": {
			"type": "boolean",
			"default": false
		},
		"buttonText": {
			"type": "string",
			"default": "Donate"
		},
		"preview": {
			"type": "boolean",
			"default": false
		}
	}
}
