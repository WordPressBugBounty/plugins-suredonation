msgstr "Edita un formulario existente para personalizar sus campos, cantidades y configuraciones."

#: assets/build/admin.js:27
msgid "Track your goal"
msgstr "Rastrea tu objetivo"

#: assets/build/admin.js:27
msgid "Watch progress toward your fundraising goal at a glance."
msgstr "Observa el progreso hacia tu objetivo de recaudación de fondos de un vistazo."

#: assets/build/admin.js:27
msgid "Monitor performance"
msgstr "Monitorea el rendimiento"

#: assets/build/admin.js:27
msgid "See revenue and key stats for the selected date range."
msgstr "Ve los ingresos y las estadísticas clave para el rango de fechas seleccionado."

#: assets/build/admin.js:27
msgid "Filter by date"
msgstr "Filtrar por fecha"

#: assets/build/admin.js:27
