msgstr "Esta campaña fue creada a partir de la plantilla “%s”. Aquí tienes un recorrido rápido de todo lo que puedes editar."

#: assets/build/admin.js:27
msgid "Your campaign is ready. Here’s a quick tour of everything you can do from this page."
msgstr "Tu campaña está lista. Aquí tienes un recorrido rápido de todo lo que puedes hacer desde esta página."

#: assets/build/admin.js:27
msgid "Welcome to your campaign"
msgstr "Bienvenido a tu campaña"

#: assets/build/admin.js:27
msgid "Edit campaign details"
msgstr "Editar detalles de la campaña"

#: assets/build/admin.js:27
msgid "Add a donation form"
msgstr "Añadir un formulario de donación"

#: assets/build/admin.js:27
msgid "Create and manage the donation forms attached to this campaign."
msgstr "Crea y gestiona los formularios de donación adjuntos a esta campaña."

#: assets/build/admin.js:27
