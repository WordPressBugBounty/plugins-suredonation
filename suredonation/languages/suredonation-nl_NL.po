msgstr "Logs inschakelen"

#: assets/build/admin.js:131
msgid "Only failures are recorded, so a site where donations are going through never creates a log at all."
msgstr "Alleen mislukkingen worden geregistreerd, dus een site waar donaties doorgaan, maakt helemaal geen log aan."

#: assets/build/admin.js:131
msgid "Could not save the setting."
msgstr "Kon de instelling niet opslaan."

#: assets/build/admin.js:131
msgid "No personal or payment information is written to the log: no donor names, email addresses, phone numbers, postal addresses, donation amounts, card details or IP addresses."
msgstr "Er worden geen persoonlijke of betalingsgegevens in de log geschreven: geen donateursnamen, e-mailadressen, telefoonnummers, postadressen, donatiebedragen, kaartgegevens of IP-adressen."

#: assets/build/admin.js:131
msgid "Log file"
msgstr "Logbestand"

#. translators: 1: file size, 2: number of days entries are kept.
#: assets/build/admin.js:132
msgid "%1$s recorded. Entries older than %2$d days are removed automatically."
msgstr "%1$s geregistreerd. Invoer ouder dan %2$d dagen wordt automatisch verwijderd."

#: assets/build/admin.js:132
msgid "Nothing has been recorded, which means nothing has failed."
msgstr "Er is niets geregistreerd, wat betekent dat er niets is mislukt."

#: assets/build/admin.js:132
msgid "The log has reached its size limit and has stopped recording. Download it if you still need it, then clear it to start recording again."
msgstr "De log heeft zijn grootte limiet bereikt en is gestopt met opnemen. Download het als u het nog nodig heeft en wis het dan om opnieuw te beginnen met opnemen."

#: assets/build/admin.js:132
msgid "The log is large enough that failures reported by donors are no longer being recorded. Server-side entries are unaffected. Clear the log to start recording them again."
msgstr "De log is groot genoeg dat mislukkingen gemeld door donateurs niet langer worden geregistreerd. Server-side invoer wordt niet beïnvloed. Wis de log om ze opnieuw te registreren."

#: assets/build/admin.js:132
msgid "Download log"
msgstr "Log downloaden"

#: assets/build/admin.js:132
msgid "Your browser will not allow copying from this page. Download the log instead."
msgstr "Uw browser staat niet toe om vanaf deze pagina te kopiëren. Download in plaats daarvan de log."

#: assets/build/admin.js:132
msgid "Could not build the report."
msgstr "Kon het rapport niet opstellen."

#: assets/build/admin.js:132
msgid "Copied"
msgstr "Gekopieerd"

#: assets/build/admin.js:132
msgid "Copy report"
msgstr "Rapport kopiëren"

#: assets/build/admin.js:132
msgid "Clear log"
msgstr "Log wissen"

#: assets/build/admin.js:132
msgid "Delete the log?"
msgstr "Log verwijderen?"

#: assets/build/admin.js:132
msgid "Could not clear the log."
msgstr "Kon de log niet wissen."

#: assets/build/admin.js:132
msgid "Clearing…"
msgstr "Bezig met wissen…"

#: assets/build/admin.js:132
msgid "Yes, delete"
msgstr "Ja, verwijderen"

