#: inc/abilities/config-ability.php:1888
#: inc/abilities/config-ability.php:1933
#: inc/abilities/config-ability.php:1990
msgid "Report on test or live donations. Defaults to the store's current mode. Test and live figures are never summed together."
msgstr "Rapporteer over test- of live-donaties. Standaard is de huidige modus van de winkel. Test- en live-cijfers worden nooit samen opgeteld."

#: inc/abilities/config-ability.php:1912
msgid "Get recent donations"
msgstr "Ontvang recente donaties"

#: inc/abilities/config-ability.php:1913
